{
	"name": "conduit",
	"version": "1.11.1",
	"description": "Conduit — a dual-pane file transfer app for local, external, and cloud storage.",
	"main": "./out/main/index.js",
	"author": "Mike Wax",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"postinstall": "node scripts/patch-wasabi-compat.js",
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"start": "electron-vite preview",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "npm run typecheck:node && npm run typecheck:web",
		"dist:mac": "electron-vite build && electron-builder --mac",
		"dist:win": "electron-vite build && electron-builder --win",
		"version:patch": "npm version patch --no-git-tag-version",
		"version:minor": "npm version minor --no-git-tag-version",
		"version:major": "npm version major --no-git-tag-version",
		"release:patch": "npm run version:patch && npm run dist:mac",
		"release:minor": "npm run version:minor && npm run dist:mac",
		"release:major": "npm run version:major && npm run dist:mac"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.637.0",
		"@aws-sdk/lib-storage": "^3.637.0",
		"basic-ftp": "^6.0.1",
		"electron-updater": "^6.3.0",
		"ssh2": "^1.17.0",
		"webdav": "^5.10.0",
		"zustand": "^4.5.5"
	},
	"devDependencies": {
		"@types/node": "^22.5.0",
		"@types/react": "^18.3.4",
		"@types/react-dom": "^18.3.0",
		"@types/ssh2": "^1.15.5",
		"@vitejs/plugin-react": "^4.3.1",
		"electron": "^32.0.1",
		"electron-builder": "^25.0.5",
		"electron-vite": "^2.3.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^5.5.4",
		"vite": "^5.4.2"
	}
}
